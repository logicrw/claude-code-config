{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant"
      ]
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-ripgrep"
      ]
    },
    "tree-sitter": {
      "command": "uvx",
      "args": [
        "mcp-server-tree-sitter"
      ]
    },
    "semgrep": {
      "command": "semgrep",
      "args": [
        "mcp"
      ]
    },
    "repomapper": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/pdavis68/RepoMapper.git",
        "repomap-mcp"
      ]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    }
  }
}
