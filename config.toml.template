[mcp_servers]

[mcp_servers.serena]
command = "uvx"
args = [ "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server", "--context", "ide-assistant" ]

[mcp_servers.ripgrep]
command = "npx"
args = [ "-y", "mcp-ripgrep" ]

[mcp_servers.tree-sitter]
command = "uvx"
args = [ "mcp-server-tree-sitter" ]

[mcp_servers.semgrep]
command = "semgrep"
args = [ "mcp" ]

[mcp_servers.repomapper]
command = "uvx"
args = [ "--from", "git+https://github.com/pdavis68/RepoMapper.git", "repomap-mcp" ]

[mcp_servers.exa]
url = "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"

[mcp_servers.exa.env_http_headers]
x-api-key = "EXA_API_KEY"
